server {
    listen 8080;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream http://{{ audit_container }}:8080;

    location = /healthz { proxy_pass $upstream; }
    location = /metrics { proxy_pass $upstream; }
    location ^~ /api/   { proxy_pass $upstream; }
    location /          { return 404; }
}

server {
    listen 8081;
    location = /stub_status { stub_status; }
}